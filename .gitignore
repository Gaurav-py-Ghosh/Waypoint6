# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta-data should only be ignored if the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache
.gradle/

# Exported Android Project
/[Ee]xportedGlobally/

# Build artifacts
*.apk
*.aab
*.unitypackage
*.app
*.log

# OS generated
.DS_Store
Thumbs.db
desktop.ini

# Visual Studio / VS Code solution & project files
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
!/[Aa]ssets/**/*.pdb
*.mdb
*.opendb
*.VC.db

.vscode/
.vsconfig

# Vuforia local cache
/QCAR/

# Unity crash-recovery scenes
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta

# Generated during builds (Vuforia license class holds the license key; never commit it)
/[Aa]ssets/VuforiaLicense.cs
/[Aa]ssets/VuforiaLicense.cs.meta
/[Aa]ssets/Resources/alpha.shader
/[Aa]ssets/Resources/alpha.shader.meta
/[Aa]ssets/Resources/PerformanceTestRun*.json
/[Aa]ssets/Resources/PerformanceTestRun*.json.meta

# Signing keys must never be in the repo
*.keystore
*.jks
